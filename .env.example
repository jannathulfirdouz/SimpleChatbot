# AWS Configuration
# The AWS region where Bedrock is available
AWS_REGION=us-east-1

# AWS credentials profile (uses default profile if not set)
AWS_PROFILE=default

# Bedrock Model Configuration
# Default model to use for chat responses
# Options: us.anthropic.claude-sonnet-4-6, us.anthropic.claude-sonnet-4-5-20250929-v1:0,
#          us.anthropic.claude-haiku-4-5-20251001-v1:0, us.anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Chatbot Settings
# Maximum number of tokens in model response
MAX_TOKENS=4096

# Number of conversation turns to keep in history
CONVERSATION_HISTORY_LIMIT=20

# Flask Web Application Settings
# Host and port for the web server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# AgentCore Runtime Settings
# Set AGENTCORE_ENABLED=true to route requests through deployed AgentCore agent
AGENTCORE_ENABLED=false
# The ARN of your deployed AgentCore agent runtime (from 'agentcore status')
AGENTCORE_AGENT_ARN=
# Region where the agent is deployed (defaults to AWS_REGION)
AGENTCORE_REGION=us-east-1
